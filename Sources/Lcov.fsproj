<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>Parse and format to LCOV your code coverage reports.</Description>
		<Product>LCOV Reports for PowerShell</Product>
		<Version>3.0.1</Version>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.Lcov.PowerShell</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<RootNamespace>Belin.Lcov</RootNamespace>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(RootNamespace).Tests" />
		<PackageReference Include="Belin.Lcov" Version="5.0.1" />
		<PackageReference Include="System.Management.Automation" Version="7.6.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="BranchCoverage.fs" />
		<Compile Include="FunctionCoverage.fs" />
		<Compile Include="LineCoverage.fs" />
		<Compile Include="Report.fs" />
		<Compile Include="SourceFile.fs" />
	</ItemGroup>
</Project>
